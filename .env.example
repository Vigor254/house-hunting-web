# Copy this file to .env and fill in real values once you've signed up for each service.
# Nothing here is required to run the site locally — every integration in
# listings/integrations.py falls back to a harmless placeholder until these are set.

# WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP_NUMBER=

# SMS — Africa's Talking https://africastalking.com/
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# M-Pesa Daraja API — https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Google Maps — https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
